      "owned_by": "external",
      "backend_url": "http://127.0.0.1:8186",
      "native_capabilities": ["text", "reranking"],
      "gateway_accepted_capabilities": ["text"]
    },
    {
      "alias": "safety-policy-agent",
      "description": "Structured policy classification",
      "runtime": "logical",
      "availability": "unavailable",
      "owned_by": "external",
      "backend_url": "http://127.0.0.1:8188",
