{
  "name": "green-roomz",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local multimodal agent gateway with host-qualified runtime profiles",
  "bin": {
    "green-roomz": "./bin/green-roomz.mjs"
  },
  "scripts": {
    "start": "node ./bin/green-roomz.mjs serve",
    "validate": "node ./bin/green-roomz.mjs validate",
    "benchmark": "node ./bin/green-roomz.mjs benchmark",
    "test": "node --test",
    "uat": "node ./scripts/uat.mjs",
    "test:e2e": "node --test ./e2e/gateway.e2e.mjs",
    "verify": "node ./e2e/verify-models.mjs",
    "eval:agent": "node ./scripts/agent-std-eval.mjs",
    "test:agent": "node --test --test-concurrency=1 ./test/dev-agent.test.mjs",
    "iterate": "node ./scripts/iterate.mjs",
    "eval:e2e": "node ./scripts/agent-e2e-eval.mjs",
    "eval:e2e:live": "node ./scripts/agent-e2e-eval.mjs --live-only",
    "eval:e2e:full": "node ./scripts/agent-e2e-eval.mjs --full --no-fail-fast --offline-only",
    "agent": "node ./bin/green-roomz.mjs agent",
    "eval:parity": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/mvp-parity-battery.ps1",
    "media:install": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/install-windows-media.ps1",
    "media:install:admin": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/install-windows-media-admin.ps1"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "UNLICENSED"
}
