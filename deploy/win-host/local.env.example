# Copy to local.env next to these scripts (gitignored; also on the deployed host
# under C:\LocalAI) and fill in private, per-host values. Environment variables
# with the same names win over this file. Never commit the real file (issue #28).

# win-host-start.ps1: machine-name guard. Unset = guard skipped with a warning.
GRZ_EXPECTED_COMPUTERNAME=<HOST>

# mvp-startup.ps1 / mvp-maintenance.ps1. On a host that already has the old
# scheduled tasks / state file registered, set these to the names already in use
# so re-running does not create a second task or reset the backoff state.
GRZ_STARTUP_STATE_FILE=C:\LocalAI\.grz_mvp_state.json
GRZ_GATEWAY_JOB_NAME=GrzMvpGateway
GRZ_AUTOHEAL_TASK=GrzMvpAutoHeal
GRZ_MAINTENANCE_TASK=GrzMvpMaintenance
