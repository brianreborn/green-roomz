# Copy to config/local.env (gitignored) and fill in private, per-host values.
# Never commit the real file: public files carry no LAN addresses, host names,
# user names or ports (issue #28; enforced by scripts/lint_privacy.py).

# scripts/pull-localai-from-lan.ps1: semicolon-separated UNC shares to try in order.
GRZ_LOCALAI_SOURCES=\\192.0.2.10\LocalAI;\\<HOST>\LocalAI

# scripts/android-sync-models.ps1: adb serial of the target phone (or pass -Device).
GRZ_ADB_SERIAL=<adb-serial>
