{
    "schema_version":  1,
    "manifest_version":  "0.1.0-windows-mvp",
    "product":  "Green-Roomz",
    "gateway":  {
                    "host":  "127.0.0.1",
                    "port":  8080,
                    "policy":  "responsive",
                    "request_body_limit_bytes":  16777216,
                    "cold_start_timeout_ms":  180000,
                    "retry_initial_ms":  150,
                    "retry_max_ms":  2000,
                    "retry_deadline_ms":  180000,
                    "session_ttl_ms":  3600000,
                    "session_limit":  64,
                    "memory_transcript_chars":  2048,
                    "memory_facts_limit":  8,
                    "cors_origins":  [

                                     ],
                    "max_warm_specialists":  1,
                    "idle_evict_ms":  120000,
                    "timing_privacy":  "off",
                    "upstream_timeout_ms":  600000,
                    "request_timeout_ms":  600000,
                    "agent_chat_timeout_ms":  60000,
                    "agent_max_tokens":  96,
                    "nexus_consult_timeout_ms":  10000,
                    "handoff_peek_timeout_ms":  8000,
                    "handoff_peek_chars":  48,
                    "admit_when_tight":  "refuse",
                    "apply_store_winners":  false,
                    "health_aliases":  [
                                           "tool-router-agent",
                                           "general-text-speculator"
                                       ]
                },
    "runtimes":  {
                     "llama_server":  {
                                          "kind":  "llama-server",
                                          "command":  "${GRZ_LLAMA}",
                                          "base_args":  [
                                                            "--host",
                                                            "127.0.0.1",
                                                            "--parallel",
                                                            "1",
                                                            "--prio",
                                                            "-1",
                                                            "--split-mode",
                                                            "none",
                                                            "--flash-attn",
                                                            "off",
                                                            "--poll",
                                                            "0"
                                                        ],
                                          "env":  {
                                                      "GGML_VULKAN":  "0"
                                                  }
                                      },
                     "whisper":  {
                                     "kind":  "whisper-server",
                                     "command":  "${GRZ_ROOT}/runtime/missing-whisper-server",
                                     "base_args":  [
                                                       "--host",
                                                       "127.0.0.1"
                                                   ],
                                     "env":  {

                                             }
                                 },
                     "piper":  {
                                   "kind":  "piper",
                                   "command":  "${GRZ_ROOT}/runtime/piper.exe",
                                   "base_args":  [

                                                 ],
                                   "env":  {

                                           }
